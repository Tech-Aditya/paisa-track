# Copy to .env for local development. Never commit .env.

# Database (used by compose.yaml and the application)
DB_NAME=paisatrack
DB_USERNAME=paisatrack
DB_PASSWORD=paisatrack_local
DB_PORT=5432
# DB_URL=jdbc:postgresql://localhost:5432/paisatrack

# Base64-encoded HMAC key, at least 32 bytes. Generate with:
#   openssl rand -base64 48
# Optional in the local profile (a random key is used when unset); required in prod.
JWT_SECRET=

# prod profile only
# SPRING_PROFILES_ACTIVE=prod
# CORS_ALLOWED_ORIGINS=https://app.example.com
# SWAGGER_ENABLED=false
# DB_POOL_MAX_SIZE=10
