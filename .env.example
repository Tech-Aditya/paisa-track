# Copy to .env for local development. Never commit .env.

# Database (used by compose.yaml and the application)
DB_NAME=paisatrack
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432
# DB_URL=jdbc:postgresql://localhost:5432/paisatrack

# Base64-encoded HMAC key, at least 32 bytes. Generate with:
#   openssl rand -base64 48
# Optional in the local profile (a random key is used when unset); required in prod.
JWT_SECRET=

# prod profile only
# SPRING_PROFILES_ACTIVE=prod            # add ",logfile" for a rotating JSON log file too
# APP_PUBLIC_URL=https://paisatrack.example.com   # shown in the startup summary
# BANNER_MODE=off                        # "console" prints the banner (stdout stops being pure JSON)
# CORS_ALLOWED_ORIGINS=https://app.example.com
# SWAGGER_ENABLED=false
# DB_POOL_MAX_SIZE=10
